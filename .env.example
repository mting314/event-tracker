# Discord bot configuration — copy to .env and fill in (never commit .env).
DISCORD_TOKEN=your-bot-token-here
# Optional: a server (guild) id for INSTANT slash-command sync while testing.
# Leave unset for global commands (propagate to all servers within ~1h).
DISCORD_GUILD_ID=
# Published events.json (decoupled from the repo). Falls back to local data/events.json if unset.
EVENTS_SOURCE=https://mting314.github.io/event-tracker/data/events.json
# Base site URL used for links in reminder messages (optional).
SITE_URL=https://mting314.github.io/event-tracker
# How often the scheduler checks for due reminders (minutes).
CHECK_INTERVAL_MIN=15
# Optional uptime monitor: the bot pings this URL after each tick (dead-man's switch).
# Create a free check at healthchecks.io with period ~ CHECK_INTERVAL_MIN and paste its ping URL.
HEALTHCHECK_URL=
# SQLite path (defaults to bot/tracker.db).
DB_PATH=bot/tracker.db

# /add command: repo it opens PRs against (owner/repo).
GITHUB_REPO=mting314/event-tracker
GITHUB_BRANCH=main
# Fine-grained PAT (Contents + Pull requests: write on the repo) so /add's Confirm
# button opens the PR itself. Without it, Confirm just returns a new-file link.
GITHUB_TOKEN=
# /add LLM fallback (Vertex AI) — needs GCP Application Default Credentials on the host.
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
# LLM_MODEL=gemini-2.5-pro   # or anthropic:claude-sonnet-4-5, openai:gpt-4o, …
